# ==============================================================================
# ROIS — Regulatory Obligation Intelligence System Environment Configuration
# ==============================================================================

# Backend Configuration
ROIS_ENV=development
API_V1_PREFIX=/api/v1
SECRET_KEY=replace-with-a-random-secret-of-at-least-32-characters
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALGORITHM=HS256

# Database
# For local development with zero external dependencies, SQLite is supported:
DATABASE_URL=sqlite:///./rois.db
# For production / PostgreSQL on Render / Docker:
# DATABASE_URL=postgresql://rois_user:rois_password@localhost:5432/rois_db

# Storage
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=25

# Optional LLM Configuration (Deterministic baseline always runs if unset)
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini
ENABLE_LLM_EXTRACTION=false

# Demo account passwords (required only when running local demo seeding)
ROIS_DEMO_ADMIN_PASSWORD=replace-with-a-unique-demo-admin-password
ROIS_DEMO_COMPLIANCE_PASSWORD=replace-with-a-unique-demo-compliance-password
ROIS_DEMO_REVIEWER_PASSWORD=replace-with-a-unique-demo-reviewer-password
ROIS_DEMO_MANAGEMENT_PASSWORD=replace-with-a-unique-demo-management-password

# CORS Configuration (Comma-separated origins)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Frontend Configuration (for frontend/.env)
VITE_API_URL=http://localhost:8000/api/v1

# Docker Compose PostgreSQL credentials (use a URL-safe password):
POSTGRES_USER=rois_user
POSTGRES_PASSWORD=replace-before-running-compose
POSTGRES_DB=rois_db
