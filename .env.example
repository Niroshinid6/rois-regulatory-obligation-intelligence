# ==============================================================================
# ROIS — Regulatory Obligation Intelligence System Environment Configuration
# ==============================================================================

# Backend Configuration
ROIS_ENV=development
API_V1_PREFIX=/api/v1
SECRET_KEY=rois-super-secret-key-change-in-production-gift-futurelab-2026
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALGORITHM=HS256

# Database
# For local development with zero external dependencies, SQLite is supported:
DATABASE_URL=sqlite:///./rois.db
# For production / PostgreSQL on Render / Docker:
# DATABASE_URL=postgresql://rois_user:rois_password@localhost:5432/rois_db

# Storage
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=25

# Optional LLM Configuration (Deterministic baseline always runs if unset)
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini
ENABLE_LLM_EXTRACTION=false

# CORS Configuration (Comma-separated origins)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Frontend Configuration (for frontend/.env)
VITE_API_URL=http://localhost:8000/api/v1
